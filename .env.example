# Trade AI — configuration. Copy to .env.local and edit.

# --- Market data (optional) -----------------------------------------------
# If set, live quotes are pulled from Finnhub (https://finnhub.io). If unset,
# the app uses simulated mock prices.
FINNHUB_API_KEY=

# --- LLM sentiment (optional) ---------------------------------------------
# If set, sentiment scores and recommendations are generated by the Claude API.
# If unset, a deterministic heuristic derives sentiment from price action.
ANTHROPIC_API_KEY=

# Seconds to cache the combined signal snapshot (limits market-data/LLM calls).
SIGNALS_TTL_SEC=30


# --- Background scheduler -------------------------------------------------
# Start the in-process scheduler on server boot. Off by default.
AUTOMATION_ENABLED=false
# How often the scheduler runs a cycle (seconds). Minimum 5.
AUTOMATION_INTERVAL_SEC=60

# --- Live trading (DANGER) ------------------------------------------------
# Leave false to use the safe simulated "paper" broker. Setting this to true
# routes orders through lib/brokers/live.ts, which you must implement against
# your own broker/exchange. Until implemented, live orders are rejected.
TRADE_AI_LIVE=false
BROKER_API_KEY=
BROKER_API_SECRET=
